# PRISM Autonomous SOC Agent Configuration

# Decision Engine Provider: "deterministic" (default, no API key needed), "gemini", or "openai"
LLM_PROVIDER=deterministic

# Optional: LLM Model Name
LLM_MODEL=gemini-1.5-flash

# Optional: API Keys (Required only if LLM_PROVIDER is set to gemini or openai)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
